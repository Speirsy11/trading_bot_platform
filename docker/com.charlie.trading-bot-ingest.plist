<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.charlie.trading-bot-ingest</string>

    <key>ProgramArguments</key>
    <array>
      <string>/bin/zsh</string>
      <string>-lc</string>
      <string>cd /Users/charliespeirs/Developer/trading_bot_platform &amp;&amp; /opt/homebrew/bin/pnpm docker:ingest:up</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
      <key>SuccessfulExit</key>
      <false/>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/trading-bot-ingest.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/trading-bot-ingest.launchd.err.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/charliespeirs/Developer/trading_bot_platform</string>
  </dict>
</plist>
